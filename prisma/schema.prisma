// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  output        = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum dir_role {
  USER
  ADMIN
}
model dir_User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  role      dir_role @default(USER)
  files     FileNode[]
}

model FileNode {
  id              String    @id @default(uuid())
  name            String
  type            String
  parentId        String?
  size            Int?
  storageKey      String?
  createdAt       DateTime  @default(now())
  userId          String?
  ocrStatus       String    @default("UNPROCESSED")
  markdownPath    String?

  recommendStatus Boolean   @default(false)
  deleteStatus    Boolean   @default(false)
  deletedAt       DateTime?

  parent   FileNode?  @relation("FileHierarchy", fields: [parentId], references: [id])
  children FileNode[] @relation("FileHierarchy")
  user     dir_User?  @relation(fields: [userId], references: [id])
}
