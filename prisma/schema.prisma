generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum dir_role {
  USER
  ADMIN
}

model dir_User {
  id             String     @id @default(cuid())
  email          String     @unique
  name           String?
  password       String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  role          dir_role     @default(USER)
  files          FileNode[]
}

model FileNode {
  id   String @id @default(uuid())
  name String 
  type String 
  parentId String?
  size       Int? 
  storageKey String? 
  createdAt  DateTime @default(now())
  user       dir_User?    @relation(fields: [userId], references: [id])
  userId     String?
  recommendStatus Boolean   @default(false)
  deleteStatus    Boolean   @default(false)
  deletedAt       DateTime?

  parent   FileNode?  @relation("FolderHierarchy", fields: [parentId], references: [id])
  children FileNode[] @relation("FolderHierarchy")

}
