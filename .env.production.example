# Production Environment Variables Template
# Copy this file to .env on your production server and fill in the actual values

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=your_production_username
POSTGRES_PASSWORD=your_secure_production_password
POSTGRES_DB=lightrag

# Database URL (auto-generated from above, but can be overridden)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://your_production_username:your_secure_production_password@db:5432/lightrag

# ============================================
# Security
# ============================================
# Generate a secure secret key:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_production_jwt_secret_key_here

# ============================================
# Redis
# ============================================
REDIS_URL=redis://redis:6379

# ============================================
# OCR Configuration
# ============================================
OCR_SERVICE_URL=http://localhost:8001
OCR_MODE=api

# OpenTyphoon API (Production)
TYPHOON_API_KEY=your_production_api_key_here
TYPHOON_API_URL=https://api.opentyphoon.ai/v1/ocr
TYPHOON_MODEL=typhoon-ocr

# ============================================
# Application
# ============================================
NODE_ENV=production
PORT=3000

# ============================================
# Optional: Ollama (if using local OCR)
# ============================================
# OLLAMA_URL=http://localhost:11434
# OLLAMA_MODEL=scb10x/typhoon-ocr1.5-3b
