# DB_URL
DATABASE_URL=postgresql://swu:swu@localhost:5470/swudirectory_db

# External API Access
UPLOAD_API_KEY=
# รันคำสั่ง console.log(require('crypto').randomBytes(32).toString('hex')); เพื่อสร้างค่า secret
JWT_SECRET="JWT_SECRET_KEY_HERE"

# Database URL (will be auto-configured in docker-compose.yml)
# For local development: postgresql://postgres:your_password@localhost:5432/swu_directory
# For Docker: postgresql://postgres:your_password@db:5432/swu_directory
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/swu_directory

# Redis URL
REDIS_URL=redis://localhost:6379

# OCR Service
OCR_SERVICE_URL=http://localhost:8001

# OCR Mode: "local" (Ollama) or "api" (OpenTyphoon API)
OCR_MODE=api

# Ollama Configuration (if OCR_MODE=local)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=scb10x/typhoon-ocr1.5-3b

# OpenTyphoon API Configuration (if OCR_MODE=api)
TYPHOON_API_KEY=your_typhoon_api_key_here
TYPHOON_API_URL=https://api.opentyphoon.ai/v1/ocr
TYPHOON_MODEL=typhoon-ocr

IMAGE_NAME=
IMAGE_VERSION=
REGISTRY_PATH=

LIGHTRAG_API_KEY=123456789
LIGHTRAG_API_URL=http://localhost:9621

NEXT_PUBLIC_BASE_PATH=/directory