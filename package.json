    "dotenv": "^17.2.3",
    "ioredis": "^5.9.2",
    "jsonwebtoken": "^9.0.3",
    "mime": "^4.1.0",
    "next": "^16.1.6",
    "pg": "^8.17.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "sharp": "^0.34.5",
    "sweetalert2": "^11.26.17",
